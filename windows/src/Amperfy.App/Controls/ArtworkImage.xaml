<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Amperfy.App.Controls.ArtworkImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
        <Image x:Name="SingleImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Grid x:Name="QuadGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="Quad0" Grid.Row="0" Grid.Column="0" Stretch="UniformToFill" />
            <Image x:Name="Quad1" Grid.Row="0" Grid.Column="1" Stretch="UniformToFill" />
            <Image x:Name="Quad2" Grid.Row="1" Grid.Column="0" Stretch="UniformToFill" />
            <Image x:Name="Quad3" Grid.Row="1" Grid.Column="1" Stretch="UniformToFill" />
        </Grid>
    </Grid>
</UserControl>
