<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Amperfy.App.Controls">
    <Page.Resources>
        <DataTemplate x:Key="RowTemplate">
            <controls:LibraryRow />
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,12,24,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Search" />
            <ProgressRing
                x:Name="BusyRing"
                Grid.Column="1"
                Width="18"
                Height="18"
                HorizontalAlignment="Left"
                IsActive="False"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="HeaderButtons"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8" />
        </Grid>
        <Grid x:Name="CategoryHost" Grid.Row="1" Padding="20,0,24,4" />
        <ListView
            x:Name="ItemsList"
            Grid.Row="2"
            Padding="12,0,12,24"
            ItemTemplate="{StaticResource RowTemplate}" />
        <Border
            x:Name="EmptyHost"
            Grid.Row="2"
            Visibility="Collapsed" />
    </Grid>
</Page>
