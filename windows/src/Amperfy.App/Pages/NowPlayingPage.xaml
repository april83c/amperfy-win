<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Amperfy.App.Controls">
    <Grid x:Name="RootGrid" Padding="24,16,24,16" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PlayerColumn" Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- large player: artwork, info, controls (filled in code) -->
        <ScrollViewer
            x:Name="PlayerScroll"
            Grid.Column="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PlayerPanel"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <controls:ArtworkImage
                    x:Name="Artwork"
                    Width="360"
                    Height="360"
                    HorizontalAlignment="Center" />
                <Grid x:Name="InfoGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="InfoPanel">
                        <HyperlinkButton x:Name="TitleButton" Padding="0" MinHeight="0" HorizontalAlignment="Left">
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource TitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="ArtistButton" Padding="0" MinHeight="0" HorizontalAlignment="Left">
                            <TextBlock
                                x:Name="ArtistText"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="AlbumButton" Padding="0" MinHeight="0" HorizontalAlignment="Left">
                            <TextBlock
                                x:Name="AlbumText"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </HyperlinkButton>
                    </StackPanel>
                    <Border x:Name="FavoriteHost" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="TransportHost" />
                <StackPanel
                    x:Name="ExtrasPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="4" />
                <TextBlock
                    x:Name="ContextText"
                    HorizontalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- queue / lyrics (filled in code) -->
        <Grid x:Name="SidePanel" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TabPanel" Orientation="Horizontal" Spacing="4" />
            <Border
                x:Name="TabContentHost"
                Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Grid>
    </Grid>
</Page>
