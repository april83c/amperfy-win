<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.Settings.LibrarySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="24,0,24,24" Spacing="4">
            <TextBlock x:Name="AccountHintText" Margin="1,0,0,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Margin="1,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Library" />
            <toolkit:SettingsExpander x:Name="LibraryExpander" Header="Synced Library" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Playlists">
                        <TextBlock x:Name="PlaylistCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Artists">
                        <TextBlock x:Name="ArtistCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Albums">
                        <TextBlock x:Name="AlbumCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Songs">
                        <TextBlock x:Name="SongCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Podcasts">
                        <TextBlock x:Name="PodcastCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Podcast Episodes">
                        <TextBlock x:Name="EpisodeCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Initial Sync">
                        <TextBlock x:Name="InitialSyncText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Background sync" />
            <toolkit:SettingsCard
                Header="Background Song Sync"
                Description="While Amperfy is running, the songs of all albums are synced in the background.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBlock x:Name="BackgroundSyncText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="New Podcast Episodes"
                Description="Podcasts are checked for new episodes periodically. Check now to fetch them immediately.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="FetchEpisodesButton" Content="Check now" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="Duplicate Entries"
                Description="Merges library entries that exist more than once with the same server ID. Runs automatically at app start.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ResolveDuplicatesButton" Content="Resolve now" />
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Auto cache" />
            <toolkit:SettingsCard Header="Newest Songs" Description="Download the newest songs of the server automatically.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC4F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoDownloadSongsToggle" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Newest Podcast Episodes" Description="Download new podcast episodes automatically.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoDownloadEpisodesToggle" />
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cache" />
            <toolkit:SettingsCard Header="Cached Songs">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBlock x:Name="CachedSongsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Cached Podcast Episodes">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBlock x:Name="CachedEpisodesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander x:Name="CacheSizeExpander" Header="Cache Size">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="CacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Songs and podcast episodes">
                        <TextBlock x:Name="PlayableCacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Artworks">
                        <TextBlock x:Name="ArtworkCacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Embedded artworks">
                        <TextBlock x:Name="EmbeddedArtworkCacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Lyrics">
                        <TextBlock x:Name="LyricsCacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="All accounts" Description="Downloaded songs and podcast episodes of all accounts (counts for the cache size limit).">
                        <TextBlock x:Name="AllAccountsCacheSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Cache folder">
                        <Button x:Name="OpenCacheFolderButton" Content="Open folder" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard
                x:Name="CacheLimitCard"
                Header="Cache Size Limit"
                Description="Downloads stop when the downloaded songs and podcast episodes of all accounts exceed the limit. 0 means no limit.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        x:Name="CacheLimitBox"
                        Width="130"
                        Minimum="0"
                        Maximum="100000"
                        SmallChange="1"
                        LargeChange="10"
                        SpinButtonPlacementMode="Compact" />
                    <ComboBox x:Name="CacheLimitUnitCombo" MinWidth="80" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="Download all songs in library"
                Description="Adds all uncached songs of the library to the download queue. This may use a lot of data and storage.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="DownloadAllSongsButton" Content="Download" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="Delete downloaded songs and podcast episodes"
                Description="Deletes the downloaded songs and podcast episodes of this account.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="DeleteCacheButton" Content="Delete" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
