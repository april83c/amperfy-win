<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.Settings.ArtworkSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="24,0,24,24" Spacing="4">
            <TextBlock x:Name="AccountHintText" Margin="1,0,0,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Margin="1,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Artworks" />
            <toolkit:SettingsExpander x:Name="ArtworkCountsExpander" Header="Artworks" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Artworks">
                        <TextBlock x:Name="ArtworkCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Not checked Artworks">
                        <TextBlock x:Name="NotCheckedCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Cached Artworks">
                        <TextBlock x:Name="CachedCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard
                Header="Download all artworks in library"
                Description="Adds all uncached artworks to the download queue. This can generate a lot of network traffic and takes storage space.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="DownloadAllButton" Content="Download" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="Delete all downloaded artworks"
                Description="Deletes the downloaded artworks. Artworks embedded in song or podcast episode files are kept.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="DeleteAllButton" Content="Delete" />
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Settings" />
            <toolkit:SettingsCard Header="Artwork Download" Description="When artworks are downloaded from the server.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DownloadSettingCombo" MinWidth="260" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Artwork Display" Description="Which artwork is shown for songs, albums and podcasts.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DisplaySettingCombo" MinWidth="260" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
