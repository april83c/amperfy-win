<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="24,0,24,24" Spacing="4">
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="16">
                <Image Width="64" Height="64" Source="ms-appx:///Assets/AppIcon.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Amperfy" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Music player for Subsonic, Navidrome and Ampache servers" />
                </StackPanel>
            </StackPanel>

            <toolkit:SettingsCard x:Name="UpdatesCard" Header="Updates">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="CheckUpdatesButton" Content="Check for updates" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SourceCard" Header="Source Code" Description="This Windows port is an unofficial, personal port of Amperfy and not affiliated with the original project. Report its issues here." IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </toolkit:SettingsCard.ActionIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander
                Header="License"
                Description="Copyright © 2019-2026 Maximilian Bauer. GNU General Public License v3.0 (GPLv3).">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <TextBlock
                                x:Name="LicenseText"
                                FontFamily="Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Acknowledgements" />
            <TextBlock
                Margin="1,0,0,4"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="This software contains additional third party software. All the third party software included or linked is redistributed under the terms and conditions of their original licenses." />
            <toolkit:SettingsExpander x:Name="PackagesExpander" Header="Windows app" Description="Libraries used by Amperfy for Windows">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F8;" />
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander x:Name="UpstreamExpander" Header="Amperfy for iOS and macOS" Description="The original app by Maximilian Bauer and its contributors">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE77B;" />
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
