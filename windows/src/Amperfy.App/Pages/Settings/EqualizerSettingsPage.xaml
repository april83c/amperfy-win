<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.Settings.EqualizerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="24,0,24,24" Spacing="4">
            <TextBlock Margin="1,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Equalizer" />
            <toolkit:SettingsCard Header="Enable Equalizer" Description="A volume compensation prevents clipping when bands are boosted.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="EqualizerToggle" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="ActiveEqualizerCard" Header="Active Equalizer">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE73E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ActiveEqualizerCombo" MinWidth="220" />
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Equalizer Editor" />
            <toolkit:SettingsCard Header="Equalizer" Description="Select an equalizer to edit or create a new one.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE70F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="EditEqualizerCombo" MinWidth="200" PlaceholderText="Select" />
                    <DropDownButton x:Name="NewEqualizerButton" Content="New" />
                </StackPanel>
            </toolkit:SettingsCard>
            <Border
                x:Name="EditorPanel"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBox x:Name="NameBox" MaxWidth="360" HorizontalAlignment="Left" Header="Name" PlaceholderText="Equalizer Name" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <Grid x:Name="BandsGrid" ColumnSpacing="4" RowSpacing="4" />
                    </ScrollViewer>
                    <TextBlock x:Name="CompensationText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="FlatButton" Content="Reset to flat" />
                        <Button x:Name="DeleteButton" Content="Delete" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
