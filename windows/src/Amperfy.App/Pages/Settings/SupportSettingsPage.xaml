<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Amperfy.App.Pages.Settings.SupportSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="24,0,24,24" Spacing="4">
            <TextBlock Margin="1,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Help" />
            <toolkit:SettingsCard
                x:Name="ReportIssueCard"
                Header="Report an issue on GitHub"
                Description="Please attach the diagnostic information (see below) to your report."
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEBE8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </toolkit:SettingsCard.ActionIcon>
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Logs" />
            <toolkit:SettingsCard x:Name="EventLogCard" Header="Event Log" IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Header="Diagnostic Information"
                Description="App version, system, library statistics, settings and the latest events as JSON. Contains no passwords.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDE1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyDiagnosticsButton" Content="Copy" />
                    <Button x:Name="ExportDiagnosticsButton" Content="Export" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="LogFolderCard" Header="Log Files">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE838;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="OpenLogFolderButton" Content="Open folder" />
            </toolkit:SettingsCard>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Automation" />
            <toolkit:SettingsExpander
                x:Name="UrlCommandsExpander"
                Header="X-Callback-URLs"
                Description="Control Amperfy from scripts, shortcuts or other apps with amperfy:// URLs (e.g. start amperfy://x-callback-url/togglePlayPause). Supports x-success and x-error callbacks.">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE71B;" />
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>

            <TextBlock Margin="1,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Usage" />
            <toolkit:SettingsExpander x:Name="StatisticsExpander" Header="Usage Statistics" Description="Collected during this session. They stay on this device.">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
